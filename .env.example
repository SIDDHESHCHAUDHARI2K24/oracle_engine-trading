# =============================================================================
# MBI Labs Oracle Engine — Environment Variables
# Copy to .env and fill in the values before running.
# =============================================================================

# --- Database (PostgreSQL 16 + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://mbi_user:mbi_password@localhost:5433/mbi

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=30

# --- Admin User (seeded via scripts/seed_admin.py) ---
ADMIN_EMAIL=admin@mbilabs.io
ADMIN_PASSWORD=change-me-on-first-login

# --- MinIO (artifact storage, Dockerized for dev) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Artifact Store (local filesystem for v1, MinIO swap point for cloud) ---
ARTIFACT_STORE_PATH=~/.mbi/artifacts

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Alpaca Markets (free paper-trading account) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- FRED (Federal Reserve Economic Data, free API key) ---
FRED_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
